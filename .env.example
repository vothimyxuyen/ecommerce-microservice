NODE_ENV=development
GATEWAY_PORT=3003
GATEWAY_HOST_PORT=3003
JWT_SECRET=replace-with-unique-p3-secret-at-least-32-random-characters
JWT_EXPIRES_IN=1h
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
PRODUCT_CACHE_TTL_SECONDS=30

KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_ORDER_CREATED=order-created

AUTH_GRPC_ADDRESS=auth-service:50051
CUSTOMER_GRPC_ADDRESS=customer-service:50052
PRODUCT_GRPC_ADDRESS=product-service:50053
ORDER_GRPC_ADDRESS=order-service:50054
SHIPMENT_GRPC_ADDRESS=shipment-service:50055

AUTH_DB_PASSWORD=replace-with-unique-p3-auth-db-password
ORDER_DB_PASSWORD=replace-with-unique-p3-order-db-password
CUSTOMER_MONGODB_URI=mongodb://customer-mongo:27017/customer_db
PRODUCT_MONGODB_URI=mongodb://product-mongo:27017/product_db
SHIPMENT_MONGODB_URI=mongodb://shipment-mongo:27017/shipment_db

AUTH_POSTGRES_HOST_PORT=5436
ORDER_POSTGRES_HOST_PORT=5437
CUSTOMER_MONGO_HOST_PORT=27019
PRODUCT_MONGO_HOST_PORT=27020
SHIPMENT_MONGO_HOST_PORT=27021
REDIS_HOST_PORT=6381
KAFKA_HOST_PORT=9094

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-unique-p3-admin-password
SEED_SHIPMENT_USERNAME=shipment
SEED_SHIPMENT_PASSWORD=replace-with-unique-p3-shipment-password

API_BASE_URL=http://localhost:3003
